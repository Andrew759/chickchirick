services:
  nginx:
    build: ./build/nginx
    ports:
      - '81:80'
    depends_on:
      - api
  api:
    build:
#      context: .
      dockerfile: ./build/Dockerfile
    ports:
      - "8081:8080"
#    depends_on:
#      - redis
    volumes:
      - .:/app
#    networks:
#      - backend

  redis:
    image: redis:latest
    environment:
      #REDIS_PASSWORD: ${REDIS_MAIN_PASSWORD}
      REDIS_USER: ${REDIS_USER}
      REDIS_USER_PASSWORD: ${REDIS_PASSWORD}
    ports:
      - ${REDIS_PORT}:${REDIS_INTERNAL_PORT}
#    volumes:
#      - ./redis_data:/data

  postgres:
    image: postgres:17.2
    environment:
      POSTGRES_DB: ${DB_NAME}
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASS}
    ports:
      - ${DB_PORT}:${DB_INTERNAL_PORT}
#    volumes:
#      - ./db_data:/var/lib/postgresql/data
  #TODO: тут нет network, возможно поэтому не будет работать

#TODO: временно убрал volumes
#volumes:
#  db_data:

networks:
  backend:
#    driver: bridge