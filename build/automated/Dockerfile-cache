ARG GOLANG_VERSION='1.25.7'
FROM golang:${GOLANG_VERSION}-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

# Компилируем бинарник сразу в корень или в /app
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -ldflags="-s -w" -o /app/main ./cmd/main.go

FROM alpine:3.21
# Используем /app, так как Viper настроен на этот путь
WORKDIR /app

# Копируем бинарник и переименовываем конфиг в .env, как того требует код
COPY --from=builder /app/main .
COPY --from=builder /app/.env.automated ./.env

EXPOSE 8080
CMD ["./main"]